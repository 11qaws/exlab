{
  "name": "exlab",
  "version": "1.3.44",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "tsx --test tests/*.test.ts",
    "test:ci": "npm run build && tsx --test tests/*.test.ts tests/*.test.mjs",
    "pages:build": "vite build --config vite.pages.config.ts",
    "pages:verify": "node scripts/verify-pages-build.mjs",
    "benchmark:stalls": "tsx scripts/benchmark-fixed-bar-stalls.ts",
    "benchmark:obstacles": "tsx scripts/benchmark-race-obstacles.ts",
    "benchmark:positions": "tsx scripts/benchmark-start-position.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "matter-js": "^0.20.0",
    "next": "16.2.12",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/matter-js": "^0.20.2",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "postcss": "8.5.24",
    "sharp": "0.35.3"
  },
  "type": "module"
}
